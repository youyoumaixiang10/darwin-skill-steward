{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin.local/schemas/approval.schema.json",
  "title": "Darwin approval",
  "type": "object",
  "required": ["schema_version", "approval_id", "status", "action", "created_at", "expires_at", "required_approval_text", "target_tree_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"type": "string"},
    "status": {"enum": ["PENDING", "CONSUMED", "EXPIRED"]},
    "action": {"enum": ["ARCHIVE", "RESTORE"]},
    "required_approval_text": {"type": "string"},
    "target_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
