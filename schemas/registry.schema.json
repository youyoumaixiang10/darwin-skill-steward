{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin.local/schemas/registry.schema.json",
  "title": "Darwin Skill Registry",
  "type": "object",
  "required": ["schema_version", "generated_at", "scan_roots", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "scan_roots": {"type": "array", "items": {"type": "string"}},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "skill_id", "display_name", "path", "origin", "scope", "runtime_id", "deployment_id", "runtime_targets", "discovery_root", "manageable", "protected", "content_sha256", "tree_sha256", "tree_hash_complete", "frontmatter_status", "missing_required_fields", "parse_errors", "structural_valid"],
        "properties": {
          "record_id": {"type": "string"},
          "skill_id": {"type": "string"},
          "description": {"type": "string"},
          "path": {"type": "string"},
          "origin": {"enum": ["CODEX_USER", "SHARED_USER", "AGENTS_USER", "PROJECT", "SYSTEM", "OFFICIAL_PLUGIN", "THIRD_PARTY_PLUGIN"]},
          "scope": {"enum": ["user", "project", "plugin", "system"]},
          "runtime_id": {"type": "string"},
          "deployment_id": {"type": "string"},
          "runtime_targets": {"type": "array", "items": {"type": "string"}},
          "discovery_root": {"type": "string"},
          "asset_state": {"enum": ["ACTIVE_RUNTIME_ASSET", "ACTIVE_PLUGIN_ASSET", "INACTIVE_CACHED_VERSION", "CACHED_VERSION_UNKNOWN"]},
          "manageable": {"type": "boolean"},
          "managed": {"type": "boolean"},
          "protected": {"type": "boolean"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tree_hash_complete": {"type": "boolean"},
          "symlink_detected": {"type": "boolean"},
          "frontmatter_status": {"enum": ["MISSING", "EMPTY", "VALID", "INVALID"]},
          "missing_required_fields": {"type": "array", "items": {"type": "string"}},
          "parse_errors": {"type": "array", "items": {"type": "string"}},
          "structural_valid": {"type": "boolean"},
          "runtime_unique_copy": {"type": "boolean"},
          "runtime_dependency_status": {"enum": ["UNKNOWN", "REQUIRED", "NOT_REQUIRED"]},
          "status": {"enum": ["DISCOVERED", "ARCHIVED"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
