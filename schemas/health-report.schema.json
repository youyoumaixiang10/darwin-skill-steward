{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin.local/schemas/health-report.schema.json",
  "title": "Darwin health report",
  "type": "object",
  "required": ["schema_version", "report_id", "generated_at", "summary", "skills", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "recommendation", "metrics", "coverage", "evidence"],
        "properties": {
          "skill_id": {"type": "string"},
          "recommendation": {"enum": ["KEEP", "OBSERVE", "ARCHIVE", "MERGE", "EVOLVE"]}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
