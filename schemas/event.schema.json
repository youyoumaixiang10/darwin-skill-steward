{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin.local/schemas/event.schema.json",
  "title": "Darwin event",
  "type": "object",
  "required": ["schema_version", "event_id", "timestamp", "event_type"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string"},
    "record_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "attribution_source": {
      "enum": ["PLATFORM", "MANAGED_SELF_REPORT", "MANUAL", "INFERRED", "UNKNOWN"]
    },
    "attribution_status": {"enum": ["OBSERVED", "EXPLICIT", "INFERRED", "UNKNOWN"]},
    "outcome": {"enum": ["POSITIVE", "REFINEMENT", "FAILURE", "UNKNOWN"]},
    "outcome_status": {"enum": ["EXPLICIT", "UNKNOWN"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_length": {"type": "integer", "minimum": 0},
    "evidence_ref": {"type": "string"}
  },
  "additionalProperties": true
}
